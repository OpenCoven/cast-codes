#!/usr/bin/env bash
set -euo pipefail

PATTERN='warp_multi_agent_api|warp_server_client|app\.warp\.dev|api\.warp\.dev|MARKETPLACE_REPO|PLATFORM_MARKETPLACE_REPO|EXTENSION_REPO|warpdotdev/'
# The neutral agent_transcript render module must stay as free of Warp-owned
# infrastructure as cli_chat — it is a leaf module both backends feed.
TARGETS='app/src/cli_chat app/src/agent_transcript'

checked_any=0
for TARGET in $TARGETS; do
    [ -d "$TARGET" ] || continue
    checked_any=1
    if grep -rnE "$PATTERN" "$TARGET" --include='*.rs'; then
        echo
        echo "ERROR: $TARGET must not reference Warp-owned infrastructure."
        echo "       See specs/castcodes-chat-panel/TECH.md for the boundary policy."
        exit 1
    fi
done

if [ "$checked_any" -eq 0 ]; then
    echo "cli_chat / agent_transcript modules not present; skipping guard."
    exit 0
fi

echo "cli_chat / agent_transcript boundary check: OK"
